{
  "name": "design-pattern-academy",
  "displayName": "Design Pattern Academy",
  "description": "Learn design patterns by implementing them in your own editor, with gated steps and automated checks.",
  "version": "0.3.0",
  "private": true,
  "publisher": "local",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Education"
  ],
  "keywords": [
    "design patterns",
    "typescript",
    "learning"
  ],
  "main": "./extension.js",
  "activationEvents": [],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "designPatternAcademy",
          "title": "Design Pattern Academy",
          "icon": "media/academy.svg"
        }
      ]
    },
    "views": {
      "designPatternAcademy": [
        {
          "id": "designPatternAcademy.exercises",
          "name": "Exercises",
          "contextualTitle": "Design Pattern Academy"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "designPatternAcademy.runChecks",
          "when": "view == designPatternAcademy.exercises",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "designPatternAcademy.open",
        "title": "Open",
        "category": "Design Pattern Academy",
        "icon": "$(mortar-board)"
      },
      {
        "command": "designPatternAcademy.runChecks",
        "title": "Run Checks",
        "category": "Design Pattern Academy",
        "icon": "$(play)"
      },
      {
        "command": "designPatternAcademy.resetExercise",
        "title": "Reset Current Exercise",
        "category": "Design Pattern Academy"
      },
      {
        "command": "designPatternAcademy.openReference",
        "title": "Open Reference Sheet",
        "category": "Design Pattern Academy"
      }
    ],
    "keybindings": [
      {
        "command": "designPatternAcademy.runChecks",
        "key": "ctrl+alt+enter",
        "mac": "cmd+alt+enter",
        "when": "editorTextFocus && resourceExtname == .ts"
      }
    ],
    "configuration": {
      "title": "Design Pattern Academy",
      "properties": {
        "designPatternAcademy.runChecksOnSave": {
          "type": "boolean",
          "default": true,
          "description": "Re-run the exercise checks every time you save the exercise file."
        },
        "designPatternAcademy.home": {
          "type": "string",
          "default": "",
          "description": "Absolute folder where exercise files (and their tsconfig) are created — nothing is written into your open workspace. Empty means <home folder>/design-pattern-academy. A leading ~ expands to your home folder."
        }
      }
    }
  }
}
